# Headless security/build verification only. Electron installers require native OS runners.
FROM node:24.22.3-alpine3.24
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm install --global pnpm@10.34.9
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY scripts ./scripts
COPY src ./src
COPY ui ./ui
COPY browser-extension ./browser-extension
COPY skills ./skills
COPY test ./test
COPY eval ./eval
RUN pnpm build && pnpm check
USER node
CMD ["node", "--test", "test/mcp-broker.test.mjs", "test/transport-auth.test.mjs", "test/client.test.mjs", "test/pairing-return.test.mjs", "test/mcp-boundaries.test.mjs", "test/vault-reset.test.mjs"]
