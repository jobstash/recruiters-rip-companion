{
  "name": "recruiters-companion",
  "version": "4.0.0",
  "private": true,
  "description": "One-command local career companion for Codex and Claude",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node build/runtime.mjs",
    "build": "node build/runtime.mjs",
    "start": "node bin/recruiters.mjs",
    "check": "node build/check.mjs",
    "test": "node build/runtime.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/common": "^10.4.15",
    "@pdf-lib/fontkit": "1.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ajv-legacy": "npm:ajv@6.12.6",
    "mammoth": "^1.12.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "saxes": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yauzl": "^3.4.0",
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  },
  "bin": {
    "recruiters": "bin/recruiters.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "ui/",
    "skills/",
    "npm-shrinkwrap.json",
    "README.md",
    "AGENTS.md",
    "!src/documents/",
    "!src/main.mjs",
    "!src/preload.cjs",
    "!src/native-host.cjs",
    "!src/install-native.mjs",
    "!src/package-release.mjs"
  ]
}
